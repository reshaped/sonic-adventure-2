; the body pose's two matrix operations, which chao/body_pose.h declares.
; XMTRX holds Ninja's current matrix

        .EXPORT     _garden_subtract_matrix
        .EXPORT     _garden_clear_translation
        .SECTION    PPOSE,CODE,ALIGN=4

; in memory, the last difference is computed in the RTS slot and never
; stored
; @asm operand: fschg-register-moves, FMOV XD0,DR0 at 0x0c6833a4 copies
; XMTRX's first two elements to FR0 and FR1 as a pair
_garden_subtract_matrix:
        TST         R4,R4
        BT/S        ?current
        MOV         R4,R6

        FMOV.S      @R5+,FR3
        MOV         #4,R0
        FMOV.S      @R6,FR2
        FSUB        FR3,FR2
        FMOV.S      FR2,@R6
        FMOV.S      @R5+,FR5
        FMOV.S      @(R0,R6),FR4
        FSUB        FR5,FR4
        FMOV.S      FR4,@(R0,R6)
        MOV         #8,R0
        FMOV.S      @R5+,FR3
        FMOV.S      @(R0,R6),FR2
        FSUB        FR3,FR2
        FMOV.S      FR2,@(R0,R6)
        MOV         #12,R0
        FMOV.S      @R5+,FR5
        FMOV.S      @(R0,R6),FR4
        FSUB        FR5,FR4
        FMOV.S      FR4,@(R0,R6)
        MOV         #16,R0
        FMOV.S      @R5+,FR3
        FMOV.S      @(R0,R6),FR2
        FSUB        FR3,FR2
        FMOV.S      FR2,@(R0,R6)
        MOV         #20,R0
        FMOV.S      @R5+,FR5
        FMOV.S      @(R0,R6),FR4
        FSUB        FR5,FR4
        FMOV.S      FR4,@(R0,R6)
        MOV         #24,R0
        FMOV.S      @R5+,FR3
        FMOV.S      @(R0,R6),FR2
        FSUB        FR3,FR2
        FMOV.S      FR2,@(R0,R6)
        MOV         #28,R0
        FMOV.S      @R5+,FR5
        FMOV.S      @(R0,R6),FR4
        FSUB        FR5,FR4
        FMOV.S      FR4,@(R0,R6)
        MOV         #32,R0
        FMOV.S      @R5+,FR3
        FMOV.S      @(R0,R6),FR2
        FSUB        FR3,FR2
        FMOV.S      FR2,@(R0,R6)
        MOV         #36,R0
        FMOV.S      @R5+,FR5
        FMOV.S      @(R0,R6),FR4
        FSUB        FR5,FR4
        FMOV.S      FR4,@(R0,R6)
        MOV         #40,R0
        FMOV.S      @R5+,FR3
        FMOV.S      @(R0,R6),FR2
        FSUB        FR3,FR2
        FMOV.S      FR2,@(R0,R6)
        MOV         #44,R0
        FMOV.S      @R5+,FR5
        FMOV.S      @(R0,R6),FR4
        FSUB        FR5,FR4
        FMOV.S      FR4,@(R0,R6)
        MOV         #48,R0
        FMOV.S      @R5+,FR3
        FMOV.S      @(R0,R6),FR2
        FSUB        FR3,FR2
        FMOV.S      FR2,@(R0,R6)
        MOV         #52,R0
        TST         R4,R4
        FMOV.S      @R5+,FR5
        FMOV.S      @(R0,R6),FR4
        FSUB        FR5,FR4
        FMOV.S      FR4,@(R0,R6)
        MOV         #56,R0
        FMOV.S      @R5+,FR3
        FMOV.S      @(R0,R6),FR2
        FSUB        FR3,FR2
        FMOV.S      FR2,@(R0,R6)
        MOV         #60,R0
        FMOV.S      @R5+,FR5
        FMOV.S      @(R0,R6),FR4
        RTS
        FSUB        FR5,FR4

; with a null matrix, subtract from XMTRX, two of its rows at a time in FR0
; to FR7
?current:
        FSCHG
        FMOV        XD0,DR0
        FMOV        XD2,DR2
        FMOV        XD4,DR4
        FMOV        XD6,DR6
        FSCHG
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR0
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR1
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR2
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR3
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR4
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR5
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR6
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR7
        FSCHG
        FMOV        DR0,XD0
        FMOV        DR2,XD2
        FMOV        DR4,XD4
        FMOV        DR6,XD6
        FSCHG
        FSCHG
        FMOV        XD8,DR0
        FMOV        XD10,DR2
        FMOV        XD12,DR4
        FMOV        XD14,DR6
        FSCHG
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR0
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR1
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR2
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR3
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR4
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR5
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR6
        FMOV.S      @R5+,FR8
        FSUB        FR8,FR7
        FSCHG
        FMOV        DR0,XD8
        FMOV        DR2,XD10
        FMOV        DR4,XD12
        FMOV        DR6,XD14
        RTS
        FSCHG
; SHC's return after an inline body, which has returned already
        RTS
        NOP

; @asm operand: fschg-register-moves, FMOV DR0,XD14 at 0x0c68342e writes
; XMTRX's last two elements as a pair
_garden_clear_translation:
        TST         R4,R4
        FLDI1       FR1
        BT/S        ?registers
        FLDI0       FR0
        ADD         #64,R4
        FMOV.S      FR1,@-R4
        FMOV.S      FR0,@-R4
        FMOV.S      FR0,@-R4
        RTS
        FMOV.S      FR0,@-R4
?registers:
        FSCHG
        FMOV        DR0,XD14
        FLDI0       FR1
        FMOV        DR0,XD12
        RTS
        FSCHG
; SHC's return after an inline body, which has returned already
        RTS
        NOP

        .END
