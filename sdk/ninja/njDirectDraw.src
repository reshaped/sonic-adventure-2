; the direct drawer's strips for a compiled model wholly beyond the near
; plane, z = 1, and the test that sorts a model by its bounding sphere
;
; a drawer sends count global records to the store queues from sq on: each an
; NJS_DIRECT_GLOBAL, or an NJS_DIRECT_GLOBAL_D8 for the D8 formats. each goes
; with the vertex records that follow it, NJS_DIRECT_VERTEX or
; NJS_DIRECT_VERTEX_D8. *cursor is the first global record, and the drawer
; leaves it past the last. the drawer returns the store queue address after
; the last block it sent. it needs the current matrix in XMTRX and FPSCR.SZ
; clear, and leaves both so
;
; light is the direct drawer's light record. it holds, by byte:
;   0    L, the light's direction, as three floats, from njSetDirectLight
;   12   -inten, from njSetDirectLightIntensity
;   16   ambient - 1, from njSetDirectLightIntensity
;   20   sx and sy, the screen's scale across and down, then its center, cx
;        and cy, from njSetDirectLight
;   36   0.5, from njSetDirectLight
;   40   the light's red, green and blue, from njSetDirectLightColor
;
; a vertex's point goes through XMTRX to (x, y, z, w), and no drawer reads w.
; the vertex goes out at (x * sx / |z| + cx, y * sy / |z| + cy) on the
; screen. its depth is 1 / |z|, which FSRRA of z * z gives
;
; under FPSCR.SZ, FMOV moves a pair of floats, the one at the lower address
; in the even register. the records order their fields for those moves. PREF
; of a store queue address sends a block. PREF of a record's address loads it
; into the cache ahead of its reads

; the bit of a global record's GP word that gives its polygons an offset color
GLOBAL_OFFSET:  .EQU    H'04
; the bytes of the light record where the screen's sx, sy, cx and cy start,
; where its 0.5 lies, and where its three color floats start. between global
; records njDirectDraw's light cursor rests on the 0.5
LIGHT_SCREEN:   .EQU    20
LIGHT_HALF:     .EQU    36
LIGHT_COLOR:    .EQU    40

        .EXPORT     _njDirectClip
        .EXPORT     _njDirectDraw
        .EXPORT     _njDirectDrawD8

        .SECTION    PSG,CODE,ALIGN=4

; Uint32 *njDirectDraw(void *light, void **cursor, Uint32 *sq, Sint32 count)
; send count global records of the plain formats, each with its vertices. a
; record opens a 32-byte parameter: GLOBALPARAM, ISPPARAM, TSPPARAM and
; TEXTUREADDR, then the face color. a record whose GP has GLOBAL_OFFSET opens
; a 64-byte one instead. four words stay unwritten before its face color, and
; the offset color follows it. the face color is the record's da, then dr, dg
; and db times the light's red, green and blue. the offset color is the
; record's sa, sr, sg and sb
;
; a vertex goes out as a 32-byte block. the block holds the vertex's param,
; then its x and y on the screen and 1 / |z|. u and v follow, then its base
; and offset intensities. where the record's mode is FALSE, word 4 is the
; vertex's uv word, and word 5 stays unwritten. where it is TRUE, for an
; environment map, u is 0.5 + 0.5 * nx' and v is 0.5 + 0.5 * ny'. n' is the
; vertex's normal n through XMTRX
;
; FV12 holds (l, ambient - 1). part k of l is -inten times the inner product
; of (L, 0) with floats 4k to 4k + 3 of XMTRX. so l . n is -inten * (L . n')
; for any n. a vertex's light s is FV12's inner product with (n, 1). its
; offset intensity is s, and its base intensity 1 + max(s, ambient - 1)
; @asm operand: fipr-registers, FIPR FV12,FV0 at 0x8c1419ca takes the light's
; inner product with XMTRX's floats 0 to 3
_njDirectDraw:
        FMOV.S      FR15,@-R15
        FMOV.S      FR14,@-R15
        FMOV.S      FR13,@-R15
        FMOV.S      FR12,@-R15
        MOV.L       R9,@-R15
        MOV.L       R8,@-R15
        FMOV.S      @R4+,FR12
        FMOV.S      @R4+,FR13
        FMOV.S      @R4+,FR14
        FLDI0       FR15
        MOV.L       @R5,R9
        PREF        @R9
        FSCHG
        FMOV        XD0,DR0
        FMOV        XD2,DR2
        FIPR        FV12,FV0
        FMOV        XD4,DR4
        FMOV        XD6,DR6
        FIPR        FV12,FV4
        FMOV        XD8,DR8
        FMOV        XD10,DR10
        FIPR        FV12,FV8
        FSCHG
        FMOV.S      FR3,FR12
        FMOV.S      FR7,FR13
        FMOV.S      FR11,FR14
        FMOV.S      @R4+,FR4
        FMOV.S      @R4+,FR15
        FMOV.S      @R4+,FR8
        FMUL        FR4,FR12
        FMOV.S      @R4+,FR9
        FMUL        FR4,FR13
        FMOV.S      @R4+,FR10
        FMUL        FR4,FR14
        FMOV.S      @R4+,FR11
?record:
        ADD         #LIGHT_COLOR-LIGHT_HALF,R4
        FMOV.S      @R4+,FR6
        ADD         #32,R9
        FMOV.S      @R4+,FR4
        PREF        @R9
        ADD         #32,R6
        FMOV.S      @R4+,FR5
        ADD         #-32,R9
        MOV.L       @R9+,R0
        FSCHG
        TST         #GLOBAL_OFFSET,R0
        MOV.L       @R9+,R0
        BT/S        ?intens
        ADD         #LIGHT_HALF-LIGHT_COLOR-12,R4
        ADD         #32,R9
        ADD         #-16,R6
        FMOV        @R9+,DR0
        FMOV        @R9+,DR2
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        PREF        @R6
        ADD         #-48,R9
        ADD         #64,R6
        FMOV        @R9+,DR0
        FMOV        @R9+,DR2
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        FMOV        @R9+,DR0
        FMUL        FR4,FR0
        FMOV        @R9+,DR2
        FMUL        FR5,FR1
        FMUL        FR6,FR3
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        BRA         ?header_sent
        ADD         #16,R9
?intens:
        ADD         #16,R9
        FMOV        @R9+,DR0
        FMUL        FR4,FR0
        FMOV        @R9+,DR2
        FMUL        FR5,FR1
        FMOV        @R9+,DR4
        FMUL        FR6,FR3
        FMOV        @R9+,DR6
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        FMOV        DR4,@-R6
        FMOV        DR6,@-R6
?header_sent:
        PREF        @R6
        CMP/EQ      #0,R0
        MOV.L       @R9+,R8
        ADD         #4,R9
        BF/S        ?env_vertex
        ADD         #32,R6
?vertex:
        FMOV        @R9+,DR4
        FMOV        @R9+,DR6
        FMOV        @R9+,DR0
        FSCHG
        FMOV.S      FR7,FR2
        FLDI1       FR7
        FTRV        XMTRX,FV4
        FLDI1       FR3
        MOV.L       @R9+,R1
        FIPR        FV12,FV0
        FMOV.S      @R9+,FR2
        PREF        @R9
        FMUL        FR6,FR6
        FCMP/GT     FR15,FR3
        FSRRA       FR6
        ADD         #32,R6
        FLDI1       FR1
        FMOV.S      FR3,@-R6
        BT          ?lit
        FMOV.S      FR15,FR3
?lit:
        FMOV.S      FR11,FR7
        FADD        FR3,FR1
        FMOV.S      FR10,FR3
        FMOV.S      FR1,@-R6
        ADD         #-4,R6
        FMUL        FR9,FR5
        FMOV.S      FR6,FR0
        FMUL        FR8,FR4
        MOV.L       R1,@-R6
        FMAC        FR0,FR5,FR7
        FMOV.S      FR6,@-R6
        FMAC        FR0,FR4,FR3
        FMOV.S      FR7,@-R6
        FSCHG
        DT          R8
        FMOV        DR2,@-R6
        PREF        @R6
        BF/S        ?vertex
        ADD         #32,R6
        BRA         ?next
        DT          R7
?env_vertex:
        FMOV        @R9+,DR4
        FMOV        @R9+,DR6
        FMOV        @R9+,DR0
        FSCHG
        FMOV.S      FR7,FR2
        FLDI1       FR7
        FTRV        XMTRX,FV4
        FLDI1       FR3
        ADD         #4,R9
        FIPR        FV12,FV0
        LDS.L       @R9+,FPUL
        FMUL        FR6,FR6
        PREF        @R9
        FCMP/GT     FR15,FR3
        FMOV.S      FR3,FR7
        FSRRA       FR6
        FLDI0       FR3
        ADD         #32,R6
        FTRV        XMTRX,FV0
        FMOV.S      FR7,@-R6
        BT          ?env_lit
        FMOV.S      FR15,FR7
?env_lit:
        FLDI1       FR3
        FMOV.S      FR0,FR2
        FADD        FR3,FR7
        FMOV.S      @R4,FR0
        FMOV.S      FR7,@-R6
        FMUL        FR0,FR1
        FMOV.S      FR11,FR7
        FADD        FR0,FR1
        FMOV.S      FR10,FR3
        FMAC        FR0,FR2,FR0
        FMOV.S      FR1,@-R6
        FMUL        FR9,FR5
        FMOV.S      FR0,@-R6
        FMUL        FR8,FR4
        FMOV.S      FR6,FR0
        DT          R8
        FSTS        FPUL,FR2
        FMAC        FR0,FR5,FR7
        FMOV.S      FR6,@-R6
        FMAC        FR0,FR4,FR3
        FMOV.S      FR7,@-R6
        FSCHG
        FMOV        DR2,@-R6
        PREF        @R6
        BF/S        ?env_vertex
        ADD         #32,R6
        BRA         ?next
        DT          R7
?next:
        BT/S        ?done
        FSCHG
        BRA         ?record
        NOP
?done:
        MOV.L       R9,@R5
        MOV.L       @R15+,R8
        MOV.L       @R15+,R9
        FMOV.S      @R15+,FR12
        FMOV.S      @R15+,FR13
        FMOV.S      @R15+,FR14
        FMOV.S      @R15+,FR15
        RTS
        MOV         R6,R0

; Sint32 njDirectClip(NJS_DIRECT_HEAD *model, Float *volume)
; sort model by its bounding sphere. the sphere's center goes through XMTRX
; to (x, y, z), and its radius is r. volume holds eight floats, as
; njSetDirectClip writes them:
;   0   the far clip
;   1   1, the near plane's z
;   2   sx and sy
;   4   the 2D clip rectangle's right and left edges, less cx
;   6   its bottom and top edges, less cy
;
; the call returns:
;   0   where z - r lies beyond the far clip, where z + r lies at or nearer
;       than z = 1, or where the sphere lies past an edge
;   1   where z - r lies beyond z = 1
;   2   otherwise, where the sphere crosses z = 1
;
; a sphere is past an edge where its nearest side, projected at depth z + r,
; lies past it. so it is past the right edge where (x - r) * sx / (z + r) + cx
; lies right of that edge
; @asm operand: ftrv-registers, FTRV XMTRX,FV4 at 0x8c141b36 takes the
; model's center through the current matrix
_njDirectClip:
        FMOV.S      @R4+,FR4
        FMOV.S      @R4+,FR5
        FMOV.S      @R4+,FR6
        FLDI1       FR7
        FTRV        XMTRX,FV4
        FMOV.S      @R4+,FR8
        FMOV.S      @R5+,FR1
        FADD        FR8,FR1
        FCMP/GT     FR1,FR6
        FADD        FR8,FR6
        FMOV.S      @R5+,FR1
        BT          ?out
        FMOV.S      @R5+,FR2
        FCMP/GT     FR1,FR6
        FMOV.S      @R5+,FR3
        BF          ?out
        FMOV.S      FR4,FR0
        FSUB        FR8,FR0
        FMOV.S      @R5+,FR9
        FMUL        FR2,FR0
        FMUL        FR6,FR9
        FCMP/GT     FR9,FR0
        FADD        FR8,FR4
        BT          ?out
        FMUL        FR4,FR2
        FMOV.S      @R5+,FR9
        FMUL        FR6,FR9
        FMOV.S      FR5,FR0
        FCMP/GT     FR2,FR9
        FSUB        FR8,FR0
        BT          ?out
        FMOV.S      @R5+,FR9
        FMUL        FR3,FR0
        FMUL        FR6,FR9
        FCMP/GT     FR9,FR0
        FADD        FR8,FR5
        BT          ?out
        FMUL        FR5,FR3
        FMOV.S      @R5+,FR9
        FMUL        FR6,FR9
        FCMP/GT     FR3,FR9
        FSUB        FR8,FR6
        BT          ?out
        FSUB        FR8,FR6
        FCMP/GT     FR1,FR6
        MOV         #1,R0
        BT          ?inside
        MOV         #2,R0
?inside:
        RTS
        NOP
?out:
        RTS
        MOV         #0,R0

; Uint32 *njDirectDrawD8(void *light, void **cursor, Uint32 *sq, Sint32 count)
; send count global records of the D8 formats, each with its vertices. a
; record opens a 32-byte parameter: GLOBALPARAM, ISPPARAM, TSPPARAM and
; TEXTUREADDR, then four words unwritten. a vertex's block holds its param,
; its x and y on the screen, 1 / |z| and its uv word. the next word stays
; unwritten, and the last two hold its base and offset colors. FTRV takes
; the 1 that NJS_DIRECT_VERTEX_D8's one holds as the point's w. of light,
; the drawer reads only sx, sy, cx and cy, from LIGHT_SCREEN on
; @asm operand: ftrv-registers, FTRV XMTRX,FV4 at 0x8c141bc4 takes a vertex
; through the current matrix
_njDirectDrawD8:
        MOV.L       @R5,R2
        PREF        @R2
        ADD         #LIGHT_SCREEN,R4
        FMOV.S      @R4+,FR8
        FMOV.S      @R4+,FR9
        FMOV.S      @R4+,FR10
        FMOV.S      @R4+,FR11
?d8_record:
        FSCHG
        ADD         #8,R2
        ADD         #16,R6
        FMOV        @R2+,DR0
        FMOV        @R2+,DR2
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        MOV         R6,R3
        MOV.L       @R2+,R1
        ADD         #4,R2
        ADD         #32,R6
?d8_vertex:
        FMOV        @R2+,DR4
        FMOV        @R2+,DR6
        FMOV        @R2+,DR0
        FMOV        @R2+,DR2
        PREF        @R2
        FTRV        XMTRX,FV4
        ADD         #32,R6
        FMOV        DR0,@-R6
        FMUL        FR6,FR6
        FSCHG
        FSRRA       FR6
        FMOV.S      FR11,FR7
        ADD         #-4,R6
        FMOV.S      FR3,@-R6
        FMUL        FR9,FR5
        FMOV.S      FR10,FR3
        FMUL        FR8,FR4
        DT          R1
        PREF        @R3
        MOV         R6,R3
        FMOV.S      FR6,FR0
        FMAC        FR0,FR5,FR7
        FMOV.S      FR6,@-R6
        FMAC        FR0,FR4,FR3
        FMOV.S      FR7,@-R6
        FSCHG
        FMOV        DR2,@-R6
        BF/S        ?d8_vertex
        ADD         #32,R6
        DT          R7
        FSCHG
        BF/S        ?d8_record
        PREF        @R3
        MOV.L       R2,@R5
        RTS
        MOV         R6,R0

        .END
