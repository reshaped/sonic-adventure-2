; Kamui's callback runner preserves FPSCR and the caller's floating-point registers.

        .EXPORT     _kmiExCallBackFunc

; FPSCR's SZ bit, which makes FMOV move pairs of longs
FPSCR_SZ:       .EQU    H'00100000

        .SECTION    PSG,CODE,ALIGN=4

; void kmiExCallBackFunc(PKMCALLBACKFUNC function, void *argument)
; call function with argument, with FPSCR's SZ bit clear. FPSCR and FR0 to
; FR15 come back as the caller left them, provided function returns with
; FPSCR's SZ and FR bits as it got them. with SZ set, each pop of FR0 to FR15
; below would move eight bytes. with FR flipped, the pops would fill the
; other bank
; @asm name: kmasm_kamui_lib_, the R11b ninja.lib member that holds it; it
; starts at 0x8c14d1f4
_kmiExCallBackFunc:
        STS         FPSCR,R0
        MOV.L       R0,@-R15
        MOV         #FPSCR_SZ/H'10000,R1
        SHLL16      R1
        NOT         R0,R0
        OR          R1,R0
        NOT         R0,R0                   ; FPSCR with SZ clear
        LDS         R0,FPSCR
        FMOV.S      FR0,@-R15
        FMOV.S      FR1,@-R15
        FMOV.S      FR2,@-R15
        FMOV.S      FR3,@-R15
        FMOV.S      FR4,@-R15
        FMOV.S      FR5,@-R15
        FMOV.S      FR6,@-R15
        FMOV.S      FR7,@-R15
        FMOV.S      FR8,@-R15
        FMOV.S      FR9,@-R15
        FMOV.S      FR10,@-R15
        FMOV.S      FR11,@-R15
        FMOV.S      FR12,@-R15
        FMOV.S      FR13,@-R15
        FMOV.S      FR14,@-R15
        FMOV.S      FR15,@-R15
        STS.L       PR,@-R15
        MOV         R4,R3
        JSR         @R3
        MOV         R5,R4
        LDS.L       @R15+,PR
        FMOV.S      @R15+,FR15
        FMOV.S      @R15+,FR14
        FMOV.S      @R15+,FR13
        FMOV.S      @R15+,FR12
        FMOV.S      @R15+,FR11
        FMOV.S      @R15+,FR10
        FMOV.S      @R15+,FR9
        FMOV.S      @R15+,FR8
        FMOV.S      @R15+,FR7
        FMOV.S      @R15+,FR6
        FMOV.S      @R15+,FR5
        FMOV.S      @R15+,FR4
        FMOV.S      @R15+,FR3
        FMOV.S      @R15+,FR2
        FMOV.S      @R15+,FR1
        FMOV.S      @R15+,FR0
        MOV.L       @R15+,R0
        LDS         R0,FPSCR
        RTS
        NOP

        .END
