; the direct drawer's near-clip loops over a strip's vertex records. a loop
; takes records i, i + 1 and i + 2 as a triangle, for each i. a triangle lies
; on one strip where its first two records' params match. only a strip's last
; record holds KM_VERTEXPARAM_ENDOFSTRIP. the loop passes each such triangle
; that crosses the near plane, z = 1, to a near clipper
;
; the clipper gets the triangle's first record and its DIRECT_*_BEHIND mask.
; it also gets the first two corners' points as XMTRX transforms them. the
; loop stores the third corner's at third. a loop needs the current matrix in
; XMTRX and FPSCR.SZ clear, and leaves both so

; the bytes of a vertex record, either format, and of a triangle's three
VERTEX_SIZE:    .EQU    32
TRIANGLE_SIZE:  .EQU    96
; a loop reads a record's first POINT_BYTES: its point and the float after it.
; the record's param lies D8_PARAM bytes into an NJS_DIRECT_VERTEX_D8, and
; PLAIN_PARAM into an NJS_DIRECT_VERTEX
POINT_BYTES:    .EQU    16
D8_PARAM:       .EQU    24
PLAIN_PARAM:    .EQU    28
; the bytes of an NJS_POINT3
POINT3_BYTES:   .EQU    12
; a strip of count records holds count - LEAD_RECORDS triangles
LEAD_RECORDS:   .EQU    2
; the mask of a triangle wholly behind the near plane, every DIRECT_*_BEHIND
; bit
ALL_BEHIND:     .EQU    7

        .IMPORT     _njDirectNearClipSubD8
        .IMPORT     _njDirectNearClipSub
        .IMPORT     _njDirectEnvNearClipSub
        .EXPORT     _njDirectCalcPointLoopD8
        .EXPORT     _njDirectCalcPointLoop
        .SECTION    PSG,CODE,ALIGN=4

; void njDirectCalcPointLoopD8(NJS_DIRECT_VERTEX_D8 *vertices, Int count,
;                              NJS_POINT3 *third)
; clip the strip of count records, 3 or more. the loop takes each point's w
; from the record, where NJS_DIRECT_VERTEX_D8's one holds 1.0. it copies R7
; into R8 and never restores R8, which SHC's calling convention keeps. its
; one caller, njDirectD8NearClip, doesn't use R8. njDirectDrawD8Clip, which
; calls that, writes R8 again before it reads it
; @asm opcode: rotcl, the ROTCL at 0x8c127138 shifts the first corner's
; near-plane test into the clipper's mask
_njDirectCalcPointLoopD8:
        FMOV.S      FR15,@-R15
        FMOV.S      FR14,@-R15
        FMOV.S      FR13,@-R15
        FMOV.S      FR12,@-R15
        MOV.L       R14,@-R15
        MOV.L       R13,@-R15
        MOV.L       R12,@-R15
        MOV.L       R11,@-R15
        MOV.L       R10,@-R15
        MOV.L       R9,@-R15
        STS.L       PR,@-R15
        PREF        @R4
        MOV         R4,R11
        MOV         R5,R10
        MOV         R6,R9
        MOV         R7,R8
        ADD         #VERTEX_SIZE,R11
        ADD         #-LEAD_RECORDS,R10
        FSCHG
        PREF        @R11
        FMOV        @R4+,DR4
        FMOV        @R4+,DR6
        FTRV        XMTRX,FV4
        ADD         #D8_PARAM-POINT_BYTES,R4
        MOV.L       @R4,R12
        FMOV        @R11+,DR8
        FMOV        @R11+,DR10
        FTRV        XMTRX,FV8
        ADD         #D8_PARAM-POINT_BYTES,R11
        MOV.L       @R11,R13
        ADD         #VERTEX_SIZE-D8_PARAM,R11
d8_triangle:
        FMOV        @R11+,DR12
        FMOV        @R11+,DR14
        ADD         #VERTEX_SIZE-POINT_BYTES,R11
        PREF        @R11
        FTRV        XMTRX,FV12
        ADD         #D8_PARAM-VERTEX_SIZE,R11
        CMP/EQ      R12,R13
        MOV.L       @R11,R14
        BF/S        d8_next
        ADD         #VERTEX_SIZE-D8_PARAM,R11
        FLDI1       FR0
        MOV         #0,R0
        FCMP/GT     FR6,FR0
        ROTCL       R0
        FCMP/GT     FR10,FR0
        ROTCL       R0
        FCMP/GT     FR14,FR0
        ROTCL       R0
        CMP/EQ      #0,R0
        BT          d8_next
        CMP/EQ      #ALL_BEHIND,R0
        BT          d8_next
        FSCHG
        FMOV.S      FR11,@-R15
        FMOV.S      FR10,@-R15
        FMOV.S      FR9,@-R15
        FMOV.S      FR8,@-R15
        ADD         #POINT3_BYTES,R9
        FMOV.S      FR14,@-R9
        FMOV.S      FR13,@-R9
        MOV         R0,R5
        FMOV.S      FR12,@-R9
        MOV         R11,R4
        BSR         _njDirectNearClipSubD8
        ADD         #-TRIANGLE_SIZE,R4
        FMOV.S      @R15+,FR8
        FMOV.S      @R15+,FR9
        FMOV.S      @R15+,FR10
        FMOV.S      @R15+,FR11
        PREF        @R11
        FSCHG
d8_next:
        DT          R10
        FMOV        DR8,DR4
        MOV         R13,R12
        FMOV        DR10,DR6
        MOV         R14,R13
        FMOV        DR12,DR8
        BF/S        d8_triangle
        FMOV        DR14,DR10
        FSCHG
        LDS.L       @R15+,PR
        MOV.L       @R15+,R9
        MOV.L       @R15+,R10
        MOV.L       @R15+,R11
        MOV.L       @R15+,R12
        MOV.L       @R15+,R13
        MOV.L       @R15+,R14
        FMOV.S      @R15+,FR12
        FMOV.S      @R15+,FR13
        FMOV.S      @R15+,FR14
        RTS
        FMOV.S      @R15+,FR15
; no path reaches the .ALIGN 4, RTS and NOP below, which SHC writes after an
; inline body
        .ALIGN      4
        RTS
        NOP

; void njDirectCalcPointLoop(NJS_DIRECT_VERTEX *vertices, Int count,
;                            NJS_POINT3 *third, Int environment)
; clip the strip of count records, 3 or more, with each point's w at 1. an
; environment above 0 picks njDirectEnvNearClipSub, and any other
; njDirectNearClipSub
; @asm opcode: rotcl, the ROTCL at 0x8c1271fa shifts the first corner's
; near-plane test into the clipper's mask
_njDirectCalcPointLoop:
        FMOV.S      FR15,@-R15
        FMOV.S      FR14,@-R15
        FMOV.S      FR13,@-R15
        FMOV.S      FR12,@-R15
        MOV.L       R14,@-R15
        MOV.L       R13,@-R15
        MOV.L       R12,@-R15
        MOV.L       R11,@-R15
        MOV.L       R10,@-R15
        MOV.L       R9,@-R15
        MOV.L       R8,@-R15
        STS.L       PR,@-R15
        PREF        @R4
        MOV         R4,R11
        MOV         R5,R10
        MOV         R6,R9
        MOV         R7,R8
        ADD         #VERTEX_SIZE,R11
        ADD         #-LEAD_RECORDS,R10
        FSCHG
        PREF        @R11
        FMOV        @R4+,DR4
        FMOV        @R4+,DR6
        FLDI1       FR7
        FTRV        XMTRX,FV4
        ADD         #PLAIN_PARAM-POINT_BYTES,R4
        MOV.L       @R4,R12
        FMOV        @R11+,DR8
        FMOV        @R11+,DR10
        FLDI1       FR11
        FTRV        XMTRX,FV8
        ADD         #PLAIN_PARAM-POINT_BYTES,R11
        MOV.L       @R11+,R13
lit_triangle:
        FMOV        @R11+,DR12
        FMOV        @R11+,DR14
        FLDI1       FR15
        ADD         #PLAIN_PARAM-POINT_BYTES,R11
        MOV.L       @R11+,R14
        PREF        @R11
        FTRV        XMTRX,FV12
        CMP/EQ      R12,R13
        BF          lit_next
        FLDI1       FR0
        MOV         #0,R0
        FCMP/GT     FR6,FR0
        ROTCL       R0
        FCMP/GT     FR10,FR0
        ROTCL       R0
        FCMP/GT     FR14,FR0
        ROTCL       R0
        CMP/EQ      #0,R0
        BT          lit_next
        CMP/EQ      #ALL_BEHIND,R0
        BT          lit_next
        FSCHG
        FMOV.S      FR11,@-R15
        FMOV.S      FR10,@-R15
        FMOV.S      FR9,@-R15
        FMOV.S      FR8,@-R15
        ADD         #POINT3_BYTES,R9
        FMOV.S      FR14,@-R9
        CMP/PL      R8
        FMOV.S      FR13,@-R9
        MOV         R0,R5
        FMOV.S      FR12,@-R9
        BT/S        lit_environment
        MOV         R11,R4
        BSR         _njDirectNearClipSub
        ADD         #-TRIANGLE_SIZE,R4
        FMOV.S      @R15+,FR8
        FMOV.S      @R15+,FR9
        FMOV.S      @R15+,FR10
        FMOV.S      @R15+,FR11
        PREF        @R11
        BRA         lit_next
        FSCHG
lit_environment:
        BSR         _njDirectEnvNearClipSub
        ADD         #-TRIANGLE_SIZE,R4
        FMOV.S      @R15+,FR8
        FMOV.S      @R15+,FR9
        FMOV.S      @R15+,FR10
        FMOV.S      @R15+,FR11
        PREF        @R11
        FSCHG
lit_next:
        DT          R10
        FMOV        DR8,DR4
        MOV         R13,R12
        FMOV        DR10,DR6
        MOV         R14,R13
        FMOV        DR12,DR8
        BF/S        lit_triangle
        FMOV        DR14,DR10
        FSCHG
        LDS.L       @R15+,PR
        MOV.L       @R15+,R8
        MOV.L       @R15+,R9
        MOV.L       @R15+,R10
        MOV.L       @R15+,R11
        MOV.L       @R15+,R12
        MOV.L       @R15+,R13
        MOV.L       @R15+,R14
        FMOV.S      @R15+,FR12
        FMOV.S      @R15+,FR13
        FMOV.S      @R15+,FR14
        RTS
        FMOV.S      @R15+,FR15
; no path reaches the .ALIGN 4, RTS and NOP below, which SHC writes after an
; inline body
        .ALIGN      4
        RTS
        NOP
        .END
