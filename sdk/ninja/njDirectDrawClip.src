; the direct drawer's strips for a compiled model that crosses the near
; plane, z = 1. each drawer is njDirectDraw.src's drawer of the same format
; with a near test. it takes and leaves the same state
;
; a vertex nearer than z = 1 is near, and so is an environment map's vertex
; at z = 1. a near vertex goes out with FSRRA of 0 as its 1 / |z|. a vertex
; changes side where it lies on the other side of z = 1 from the vertex
; before it. where a strip has some vertices near and some not, the drawer
; sends all of its vertices, then calls a near clip on the strip. the near
; clip is njDirectNearClip, njDirectEnvNearClip for an environment map, or
; njDirectD8NearClip. it takes sq in R6, and returns the store queue address
; after what it sends. it sends nothing while NJD_CONTROL_3D_DISABLE_NEAR_CLIP
; is set

; the bit of a global record's GP word that gives its polygons an offset color
GLOBAL_OFFSET:  .EQU    H'04
; the bytes of the light record where the screen's sx, sy, cx and cy start,
; where its 0.5 lies, and where its three color floats start. between global
; records njDirectDrawClip's light cursor rests on the 0.5
LIGHT_SCREEN:   .EQU    20
LIGHT_HALF:     .EQU    36
LIGHT_COLOR:    .EQU    40

        .EXPORT     _njDirectDrawClip
        .EXPORT     _njDirectDrawD8Clip
        .IMPORT     _njDirectNearClip
        .IMPORT     _njDirectEnvNearClip
        .IMPORT     _njDirectD8NearClip
        .SECTION    PSG,CODE,ALIGN=4

; Uint32 *njDirectDrawClip(void *light, void **cursor, Uint32 *sq,
;                          Sint32 count)
; njDirectDraw with the near test. for a record of mode FALSE, the drawer
; calls njDirectNearClip with the record in R4. FV4 then holds njDirectDraw's
; FV12, (l, ambient - 1). R7 holds the first vertex record that changes side.
; R5 holds the count of bytes from R7 to the record after the last that
; changes side. for an environment map, njDirectEnvNearClip takes the record
; in R4, its vertex count in R5, and FV4
; @asm operand: fipr-registers, FIPR FV12,FV0 at 0x8c141676 takes the light's
; inner product with XMTRX's floats 0 to 3
_njDirectDrawClip:
        FMOV.S      FR15,@-R15
        FMOV.S      FR14,@-R15
        FMOV.S      FR13,@-R15
        FMOV.S      FR12,@-R15
        MOV.L       R14,@-R15
        MOV.L       R13,@-R15
        MOV.L       R12,@-R15
        MOV.L       R11,@-R15
        MOV.L       R10,@-R15
        MOV.L       R9,@-R15
        MOV.L       R8,@-R15
        STS.L       PR,@-R15
        FMOV.S      @R4+,FR12
        FMOV.S      @R4+,FR13
        FMOV.S      @R4+,FR14
        FLDI0       FR15
        MOV.L       @R5,R9
        PREF        @R9
        FSCHG
        FMOV        XD0,DR0
        FMOV        XD2,DR2
        FIPR        FV12,FV0
        FMOV        XD4,DR4
        FMOV        XD6,DR6
        FIPR        FV12,FV4
        FMOV        XD8,DR8
        FMOV        XD10,DR10
        FIPR        FV12,FV8
        FSCHG
        FMOV.S      FR3,FR12
        FMOV.S      FR7,FR13
        FMOV.S      FR11,FR14
        FMOV.S      @R4+,FR4
        FMOV.S      @R4+,FR15
        FMOV.S      @R4+,FR8
        FMUL        FR4,FR12
        FMOV.S      @R4+,FR9
        FMUL        FR4,FR13
        FMOV.S      @R4+,FR10
        FMUL        FR4,FR14
        FMOV.S      @R4+,FR11
?record:
        ADD         #LIGHT_COLOR-LIGHT_HALF,R4
        MOV         R9,R3
        FMOV.S      @R4+,FR6
        ADD         #32,R9
        FMOV.S      @R4+,FR4
        PREF        @R9
        ADD         #32,R6
        FMOV.S      @R4+,FR5
        ADD         #-32,R9
        MOV.L       @R9+,R0
        FSCHG
        TST         #GLOBAL_OFFSET,R0
        MOV.L       @R9+,R0
        BT/S        ?intens
        ADD         #LIGHT_HALF-LIGHT_COLOR-12,R4
        ADD         #32,R9
        ADD         #-16,R6
        FMOV        @R9+,DR0
        FMOV        @R9+,DR2
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        PREF        @R6
        ADD         #-48,R9
        ADD         #64,R6
        FMOV        @R9+,DR0
        FMOV        @R9+,DR2
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        FMOV        @R9+,DR0
        FMUL        FR4,FR0
        FMOV        @R9+,DR2
        FMUL        FR5,FR1
        FMUL        FR6,FR3
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        BRA         ?header_sent
        ADD         #16,R9
?intens:
        ADD         #16,R9
        FMOV        @R9+,DR0
        FMUL        FR4,FR0
        FMOV        @R9+,DR2
        FMUL        FR5,FR1
        FMOV        @R9+,DR4
        FMUL        FR6,FR3
        FMOV        @R9+,DR6
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        FMOV        DR4,@-R6
        FMOV        DR6,@-R6
?header_sent:
        PREF        @R6
        ADD         #32,R6
        MOV.L       @R9+,R8
        CMP/EQ      #0,R0
        MOV         R8,R2
        ADD         #4,R9
        MOV         #0,R0
        MOV         #0,R10
        BF/S        ?env_vertex
        MOV         #0,R14
        FMOV        @R9+,DR4
        FMOV        @R9+,DR6
        FMOV        @R9+,DR0
        FSCHG
        FMOV.S      FR7,FR2
        FLDI1       FR7
        FTRV        XMTRX,FV4
        FLDI1       FR7
        FCMP/GT     FR6,FR7
        BRA         ?first
        MOVT        R12
?vertex:
        FMOV        @R9+,DR4
        FMOV        @R9+,DR6
        FMOV        @R9+,DR0
        FSCHG
        FMOV.S      FR7,FR2
        FLDI1       FR7
        FTRV        XMTRX,FV4
?first:
        FLDI1       FR3
        MOV.L       @R9+,R1
        FIPR        FV12,FV0
        FLDI1       FR1
        FMOV.S      @R9+,FR2
        FCMP/GT     FR6,FR1
        PREF        @R9
        FMUL        FR6,FR6
        BF/S        ?near_tested
        MOVT        R13
        FLDI0       FR6
        ADD         #1,R0
?near_tested:
        CMP/EQ      R12,R13
        FSRRA       FR6
        BT/S        ?side_kept
        CMP/PL      R14
        MOV         #1,R14
        MOV         R9,R11
        BT          ?side_kept
        MOV         R9,R10
?side_kept:
        ADD         #32,R6
        FLDI1       FR1
        FMOV.S      FR3,@-R6
        FCMP/GT     FR15,FR3
        FMOV.S      FR11,FR7
        BT          ?lit
        FMOV.S      FR15,FR3
?lit:
        FADD        FR3,FR1
        FMOV.S      FR10,FR3
        MOV         R13,R12
        FMOV.S      FR1,@-R6
        ADD         #-4,R6
        FMUL        FR9,FR5
        FMOV.S      FR6,FR0
        FMUL        FR8,FR4
        MOV.L       R1,@-R6
        FMAC        FR0,FR5,FR7
        FMOV.S      FR6,@-R6
        FMAC        FR0,FR4,FR3
        FMOV.S      FR7,@-R6
        FSCHG
        DT          R8
        FMOV        DR2,@-R6
        PREF        @R6
        BF/S        ?vertex
        ADD         #32,R6
        CMP/EQ      #0,R0
        BT          ?vertices_sent
        CMP/GE      R2,R0
        BT          ?vertices_sent
        FSCHG
        FMOV.S      FR11,@-R15
        FMOV.S      FR10,@-R15
        FMOV.S      FR9,@-R15
        FMOV.S      FR8,@-R15
        MOV.L       R7,@-R15
        MOV.L       R5,@-R15
        MOV.L       R4,@-R15
        FMOV.S      FR12,FR4
        FMOV.S      FR13,FR5
        FMOV.S      FR14,FR6
        FMOV.S      FR15,FR7
        ADD         #-32,R10
        MOV         R11,R5
        MOV.L       ?near_clip,R0
        SUB         R10,R5
        MOV         R3,R4
        JSR         @R0
        MOV         R10,R7
        MOV         R0,R6
        MOV.L       @R15+,R4
        MOV.L       @R15+,R5
        MOV.L       @R15+,R7
        FMOV.S      @R15+,FR8
        FMOV.S      @R15+,FR9
        FMOV.S      @R15+,FR10
        FMOV.S      @R15+,FR11
        FSCHG
?vertices_sent:
        BRA         ?next
        DT          R7
?near_clip:
        .DATA.L     _njDirectNearClip
?env_vertex:
        FMOV        @R9+,DR4
        FMOV        @R9+,DR6
        FMOV        @R9+,DR0
        FSCHG
        FMOV.S      FR7,FR2
        FLDI1       FR7
        FTRV        XMTRX,FV4
        FLDI1       FR3
        ADD         #4,R9
        FIPR        FV12,FV0
        FLDI1       FR7
        LDS.L       @R9+,FPUL
        FCMP/GT     FR7,FR6
        BT          ?env_near_tested
        FLDI0       FR6
        ADD         #1,R0
?env_near_tested:
        PREF        @R9
        FMUL        FR6,FR6
        FCMP/GT     FR15,FR3
        FSRRA       FR6
        FMOV.S      FR3,FR7
        FLDI0       FR3
        ADD         #32,R6
        FTRV        XMTRX,FV0
        FMOV.S      FR7,@-R6
        BT          ?env_lit
        FMOV.S      FR15,FR7
?env_lit:
        FLDI1       FR3
        DT          R8
        FMOV.S      FR0,FR2
        FADD        FR3,FR7
        FMOV.S      @R4,FR0
        FMOV.S      FR7,@-R6
        FMUL        FR0,FR1
        FMOV.S      FR11,FR7
        FADD        FR0,FR1
        FMOV.S      FR10,FR3
        FMAC        FR0,FR2,FR0
        FMOV.S      FR1,@-R6
        FMUL        FR9,FR5
        FMOV.S      FR0,@-R6
        FMUL        FR8,FR4
        FMOV.S      FR6,FR0
        FSTS        FPUL,FR2
        FMAC        FR0,FR5,FR7
        FMOV.S      FR6,@-R6
        FMAC        FR0,FR4,FR3
        FMOV.S      FR7,@-R6
        FSCHG
        FMOV        DR2,@-R6
        PREF        @R6
        BF/S        ?env_vertex
        ADD         #32,R6
        CMP/EQ      #0,R0
        BT          ?env_sent
        CMP/GE      R2,R0
        BT          ?env_sent
        FSCHG
        FMOV.S      FR11,@-R15
        FMOV.S      FR10,@-R15
        FMOV.S      FR9,@-R15
        FMOV.S      FR8,@-R15
        MOV.L       R7,@-R15
        MOV.L       R5,@-R15
        MOV.L       R4,@-R15
        FMOV.S      FR12,FR4
        FMOV.S      FR13,FR5
        FMOV.S      FR14,FR6
        FMOV.S      FR15,FR7
        MOV.L       ?env_near_clip,R0
        MOV         R3,R4
        JSR         @R0
        MOV         R2,R5
        MOV         R0,R6
        MOV.L       @R15+,R4
        MOV.L       @R15+,R5
        MOV.L       @R15+,R7
        FMOV.S      @R15+,FR8
        FMOV.S      @R15+,FR9
        FMOV.S      @R15+,FR10
        FMOV.S      @R15+,FR11
        FSCHG
?env_sent:
        BRA         ?next
        DT          R7
?env_near_clip:
        .DATA.L     _njDirectEnvNearClip
?next:
        BT/S        ?done
        FSCHG
        BRA         ?record
        NOP
?done:
        MOV.L       R9,@R5
        LDS.L       @R15+,PR
        MOV.L       @R15+,R8
        MOV.L       @R15+,R9
        MOV.L       @R15+,R10
        MOV.L       @R15+,R11
        MOV.L       @R15+,R12
        MOV.L       @R15+,R13
        MOV.L       @R15+,R14
        FMOV.S      @R15+,FR12
        FMOV.S      @R15+,FR13
        FMOV.S      @R15+,FR14
        FMOV.S      @R15+,FR15
        RTS
        MOV         R6,R0

; Uint32 *njDirectDrawD8Clip(void *light, void **cursor, Uint32 *sq,
;                            Sint32 count)
; njDirectDrawD8 with the near test. njDirectD8NearClip takes the record in
; R4, and R5 and R7 as njDirectDrawClip passes them
; @asm operand: ftrv-registers, FTRV XMTRX,FV4 at 0x8c141900 takes a vertex
; through the current matrix
_njDirectDrawD8Clip:
        FMOV.S      FR15,@-R15
        FMOV.S      FR14,@-R15
        FMOV.S      FR13,@-R15
        FMOV.S      FR12,@-R15
        MOV.L       R14,@-R15
        MOV.L       R13,@-R15
        MOV.L       R12,@-R15
        MOV.L       R11,@-R15
        MOV.L       R10,@-R15
        MOV.L       R9,@-R15
        MOV.L       R8,@-R15
        STS.L       PR,@-R15
        MOV.L       @R5,R9
        PREF        @R9
        ADD         #LIGHT_SCREEN,R4
        FMOV.S      @R4+,FR12
        FMOV.S      @R4+,FR13
        FMOV.S      @R4+,FR14
        FMOV.S      @R4+,FR15
?d8_record:
        FSCHG
        MOV         R9,R8
        ADD         #8,R9
        ADD         #16,R6
        FMOV        @R9+,DR0
        FMOV        @R9+,DR2
        FMOV        DR0,@-R6
        FMOV        DR2,@-R6
        MOV         R6,R3
        MOV.L       @R9+,R1
        ADD         #4,R9
        PREF        @R9
        ADD         #32,R6
        MOV         #0,R0
        MOV         R1,R2
        MOV         #0,R10
        MOV         #0,R14
        FMOV        @R9+,DR4
        FMOV        @R9+,DR6
        FMOV        @R9+,DR0
        FMOV        @R9+,DR2
        PREF        @R9
        FTRV        XMTRX,FV4
        FLDI1       FR7
        FCMP/GT     FR6,FR7
        BRA         ?d8_first
        MOVT        R12
?d8_vertex:
        FMOV        @R9+,DR4
        FMOV        @R9+,DR6
        FMOV        @R9+,DR0
        FMOV        @R9+,DR2
        PREF        @R9
        FTRV        XMTRX,FV4
?d8_first:
        FLDI1       FR7
        ADD         #32,R6
        FMOV        DR0,@-R6
        FSCHG
        FCMP/GT     FR6,FR7
        FMUL        FR6,FR6
        MOVT        R13
        BF          ?d8_near_tested
        FLDI0       FR6
        ADD         #1,R0
?d8_near_tested:
        FSRRA       FR6
        FMOV.S      FR15,FR7
        CMP/EQ      R12,R13
        ADD         #-4,R6
        BT/S        ?d8_side_kept
        FMOV.S      FR3,@-R6
        CMP/PL      R14
        MOV         #1,R14
        MOV         R9,R11
        BT          ?d8_side_kept
        MOV         R9,R10
?d8_side_kept:
        FMUL        FR13,FR5
        FMOV.S      FR14,FR3
        FMUL        FR12,FR4
        DT          R1
        PREF        @R3
        MOV         R6,R3
        FMOV.S      FR6,FR0
        MOV         R13,R12
        FMAC        FR0,FR5,FR7
        FMOV.S      FR6,@-R6
        FMAC        FR0,FR4,FR3
        FMOV.S      FR7,@-R6
        FSCHG
        FMOV        DR2,@-R6
        BF/S        ?d8_vertex
        ADD         #32,R6
        CMP/EQ      #0,R0
        PREF        @R3
        BT/S        ?d8_next
        FSCHG
        CMP/EQ      R0,R2
        BT          ?d8_next
        MOV.L       R5,@-R15
        MOV.L       R7,@-R15
        ADD         #-32,R10
        MOV         R11,R5
        MOV.L       ?d8_near_clip,R0
        SUB         R10,R5
        MOV         R8,R4
        JSR         @R0
        MOV         R10,R7
        MOV         R0,R6
        MOV.L       @R15+,R7
        MOV.L       @R15+,R5
?d8_next:
        DT          R7
        BF          ?d8_record
        MOV.L       R9,@R5
        LDS.L       @R15+,PR
        MOV.L       @R15+,R8
        MOV.L       @R15+,R9
        MOV.L       @R15+,R10
        MOV.L       @R15+,R11
        MOV.L       @R15+,R12
        MOV.L       @R15+,R13
        MOV.L       @R15+,R14
        FMOV.S      @R15+,FR12
        FMOV.S      @R15+,FR13
        FMOV.S      @R15+,FR14
        FMOV.S      @R15+,FR15
        RTS
        MOV         R6,R0
        .ALIGN      4
?d8_near_clip:
        .DATA.L     _njDirectD8NearClip

        .END
