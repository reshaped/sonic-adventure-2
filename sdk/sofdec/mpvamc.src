; the motion compensation's predictions of a block from reference pixels:
; copies, and averages of two or four pixels

; byte offsets of struct mpv_mc's fields
MC_BLOCK:       .EQU    24
MC_PITCH:       .EQU    32
MC_SRC:         .EQU    36
MC_SRC2:        .EQU    40
; mc->copy's entries, one for each value of a source address's two low bits.
; sofdec.h defines the count by the same name
MPVMC_COPIES:   .EQU    4
; a block has BLK_LINES rows of ROW_BYTES pixels
BLK_LINES:      .EQU    8
ROW_BYTES:      .EQU    8

        .EXPORT     _MPVAMC_OneRef1
        .EXPORT     _MPVAMC_OneRef1Byte
        .EXPORT     _MPVAMC_OneRef1Word
        .EXPORT     _MPVAMC_OneRef1Long
        .EXPORT     _MPVAMC_OneRefV2
        .EXPORT     _MPVAMC_OneRefH2
        .EXPORT     _MPVAMC_OneRef4

        .SECTION    PSGSFD00,CODE,ALIGN=4

; void MPVAMC_OneRef1(struct mpv_mc *mc)
; copy the block at mc->src, its rows mc->pitch bytes apart, to mc->block.
; after a PREF of mc->src, it tail-calls
; mc->copy[mc->src & 3](mc->block, mc->src, mc->pitch)
; @asm open: every instruction is one SHC writes for C
_MPVAMC_OneRef1:
        MOV.L       @(MC_SRC,R4),R5
        PREF        @R5
        MOV         R5,R0
        AND         #MPVMC_COPIES-1,R0
        MOV.L       @(MC_PITCH,R4),R6
        SHLL2       R0
        MOV.L       @(R0,R4),R1
        JMP         @R1
        MOV.L       @(MC_BLOCK,R4),R4
        .ALIGN      4

; void MPVAMC_OneRef1Byte(Uint8 *block, const Uint8 *src, Sint32 pitch)
; an MPVMC_COPY, whose contract sofdec.h gives
; @asm opcode: swap, SWAP.W R7,R7 at 0x8c18a770 moves a row's first two bytes
; to the word's top half
_MPVAMC_OneRef1Byte:
        MOV.L       R14,@-R15
        ADD         #-ROW_BYTES,R4
        MOV.L       R13,@-R15
        MOV.L       R12,@-R15
        MOV.L       R11,@-R15
        ADD         #1-ROW_BYTES,R6
        MOV.L       R9,@-R15
        MOV         #BLK_LINES,R9
        MOV.B       @R5+,R0
?byte_row:
        MOV.B       @R5+,R1
        ADD         #2*ROW_BYTES,R4
        MOV.B       @R5+,R2
        EXTU.B      R0,R7
        MOV.B       @R5+,R3
        SHLL8       R1
        MOV.B       @R5+,R11
        OR          R1,R7
        MOV.B       @R5+,R12
        EXTU.B      R2,R2
        MOV.B       @R5+,R13
        SHLL8       R3
        MOV.B       @R5,R14
        ADD         R6,R5
        MOV.B       @R5+,R0
        SWAP.W      R7,R7
        MOV.B       R14,@-R4
        OR          R3,R2
        MOV.B       R13,@-R4
        XTRCT       R2,R7
        MOV.B       R12,@-R4
        DT          R9
        MOV.B       R11,@-R4
        BF/S        ?byte_row
        MOV.L       R7,@-R4
        MOV.L       @R15+,R9
        MOV.L       @R15+,R11
        MOV.L       @R15+,R12
        MOV.L       @R15+,R13
        RTS
        MOV.L       @R15+,R14
        .ALIGN      4

; void MPVAMC_OneRef1Word(Uint8 *block, const Uint8 *src, Sint32 pitch)
; an MPVMC_COPY, whose contract sofdec.h gives
; @asm operand: zero-displacement, MOV.L R0,@(0,R4) at 0x8c18a7a8 stores a
; row's first four bytes
_MPVAMC_OneRef1Word:
        ADD         #2-ROW_BYTES,R6
        MOV         #BLK_LINES,R7
        ADD         #-ROW_BYTES,R4
?word_row:
        MOV.W       @R5+,R0
        ADD         #ROW_BYTES,R4
        DT          R7
        MOV.W       @R5+,R1
        SHLL16      R0
        MOV.W       @R5+,R2
        XTRCT       R1,R0
        MOV.W       @R5,R3
        SHLL16      R2
        MOV.L       R0,@(0,R4)
        XTRCT       R3,R2
        MOV.L       R2,@(4,R4)
        BF/S        ?word_row
        ADD         R6,R5
        RTS
        NOP
        .ALIGN      4

; void MPVAMC_OneRef1Long(Uint8 *block, const Uint8 *src, Sint32 pitch)
; an MPVMC_COPY, whose contract sofdec.h gives
; @asm open: every instruction is one SHC writes for C
_MPVAMC_OneRef1Long:
        ADD         #4-ROW_BYTES,R6
        MOV.L       @R5+,R3
        MOV.L       @R5,R7
        ADD         R6,R5
        MOV.L       @R5+,R1
        MOV.L       @R5,R2
        MOV.L       R3,@R4
        ADD         R6,R5
        MOV.L       R7,@(4,R4)
        MOV.L       @R5+,R3
        MOV.L       @R5,R7
        ADD         R6,R5
        MOV.L       R1,@(ROW_BYTES,R4)
        MOV.L       R2,@(ROW_BYTES+4,R4)
        MOV.L       @R5+,R1
        MOV.L       @R5,R2
        MOV.L       R3,@(2*ROW_BYTES,R4)
        ADD         R6,R5
        MOV.L       R7,@(2*ROW_BYTES+4,R4)
        MOV.L       @R5+,R7
        MOV.L       @R5,R0
        ADD         R6,R5
        MOV.L       R1,@(3*ROW_BYTES,R4)
        MOV.L       R2,@(3*ROW_BYTES+4,R4)
        MOV.L       @R5+,R2
        MOV.L       @R5,R3
        MOV.L       R7,@(4*ROW_BYTES,R4)
        ADD         R6,R5
        MOV.L       R0,@(4*ROW_BYTES+4,R4)
        MOV.L       @R5+,R7
        MOV.L       @R5,R1
        ADD         R6,R5
        MOV.L       R2,@(5*ROW_BYTES,R4)
        MOV.L       R3,@(5*ROW_BYTES+4,R4)
        MOV.L       @R5+,R3
        MOV.L       @R5,R5
        MOV.L       R7,@(6*ROW_BYTES,R4)
        MOV.L       R1,@(6*ROW_BYTES+4,R4)
        MOV.L       R3,@(7*ROW_BYTES,R4)
        RTS
        MOV.L       R5,@(7*ROW_BYTES+4,R4)
        .ALIGN      4

; void MPVAMC_OneRefV2(struct mpv_mc *mc)
; set each pixel of mc->block to (a + b + c) >> 1. a and b are the pixels at
; its place in mc->src and in mc->src2. c is 1 for a row's first pixel. for
; each later pixel, c is the low bit of the sum the pixel before it halved.
; the rows of mc->src and mc->src2 lie mc->pitch bytes apart. the call also
; reads mc->src[8 * mc->pitch] and mc->src2[8 * mc->pitch], which must be
; readable
; @asm opcode: sett, SETT at 0x8c18a820 sets T for a row's first ADDC
_MPVAMC_OneRefV2:
        MOV.L       R14,@-R15
        MOV.L       R13,@-R15
        MOV.L       @(MC_PITCH,R4),R14
        MOV.L       @(MC_SRC,R4),R6
        MOV         #BLK_LINES,R1
        MOV.L       @(MC_SRC2,R4),R7
        MOV.L       @(MC_BLOCK,R4),R13
        ADD         #1-ROW_BYTES,R14
        MOV.B       @R6+,R2
        MOV.B       @R7+,R3
?v2_row:
        SETT
        EXTU.B      R2,R2
        MOV.B       @R6+,R4
        EXTU.B      R3,R3
        MOV.B       @R7+,R5
        ADDC        R3,R2
        ; @bug logic: a later pixel of a row rounds a half down where the sum
        ; the pixel before it halved was even. this SETT at 0x8c18a82c is
        ; meant to set c to 1 for ADDC R4,R0 at 0x8c18a83a. SHAR R2 at
        ; 0x8c18a82e replaces T first, with the low bit of the sum it halves
        SETT
        SHAR        R2
        EXTU.B      R4,R4
        MOV.B       R2,@R13
        MOV.B       @R6+,R2
        EXTU.B      R5,R0
        MOV.B       @R7+,R3
        ADDC        R4,R0
        SETT
        SHAR        R0
        EXTU.B      R2,R2
        MOV.B       R0,@(1,R13)
        MOV.B       @R6+,R4
        EXTU.B      R3,R0
        MOV.B       @R7+,R5
        ADDC        R2,R0
        SETT
        SHAR        R0
        EXTU.B      R4,R4
        MOV.B       R0,@(2,R13)
        MOV.B       @R6+,R2
        EXTU.B      R5,R0
        MOV.B       @R7+,R3
        ADDC        R4,R0
        SETT
        SHAR        R0
        EXTU.B      R2,R2
        MOV.B       R0,@(3,R13)
        MOV.B       @R6+,R4
        EXTU.B      R3,R0
        MOV.B       @R7+,R5
        ADDC        R2,R0
        SETT
        SHAR        R0
        EXTU.B      R4,R4
        MOV.B       R0,@(4,R13)
        MOV.B       @R6+,R2
        EXTU.B      R5,R0
        MOV.B       @R7+,R3
        ADDC        R4,R0
        SETT
        SHAR        R0
        EXTU.B      R2,R2
        MOV.B       R0,@(5,R13)
        MOV.B       @R6,R4
        EXTU.B      R3,R0
        MOV.B       @R7,R5
        ADDC        R2,R0
        SETT
        SHAR        R0
        EXTU.B      R4,R4
        MOV.B       R0,@(6,R13)
        EXTU.B      R5,R0
        ADD         R14,R6
        ADDC        R4,R0
        ADD         R14,R7
        MOV.B       @R6+,R2
        SHAR        R0
        MOV.B       @R7+,R3
        DT          R1
        MOV.B       R0,@(7,R13)
        BF/S        ?v2_row
        ADD         #ROW_BYTES,R13
        MOV.L       @R15+,R13
        RTS
        MOV.L       @R15+,R14
        .ALIGN      4

; void MPVAMC_OneRefH2(struct mpv_mc *mc)
; set each pixel of mc->block to (a + b + c) >> 1. a is the pixel at its
; place in mc->src, and b the one to its right. c is as in MPVAMC_OneRefV2.
; mc->src's rows lie mc->pitch bytes apart
; @asm opcode: sett, SETT at 0x8c18a8e4 sets T for a row's first ADDC
_MPVAMC_OneRefH2:
        MOV.L       R14,@-R15
        MOV.L       R13,@-R15
        MOV         #1,R7
        MOV.L       @(MC_PITCH,R4),R14
        MOV         #7,R13
        MOV.L       @(MC_BLOCK,R4),R0
        MOV         #BLK_LINES,R1
        MOV.L       @(MC_SRC,R4),R6
        ADD         #-ROW_BYTES,R14
        MOV.L       R12,@-R15
        ADD         #-ROW_BYTES,R0
        MOV.L       R11,@-R15
        MOV         #6,R12
        MOV.L       R10,@-R15
        MOV         #5,R11
        MOV.L       R9,@-R15
        MOV         #4,R10
        MOV.L       R8,@-R15
        MOV         #3,R9
        MOV         #2,R8
?h2_row:
        MOV.B       @R6+,R2
        MOV.B       @R6+,R3
        ADD         #ROW_BYTES,R0
        MOV.B       @R6+,R4
        EXTU.B      R2,R2
        EXTU.B      R3,R3
        SETT
        EXTU.B      R4,R4
        MOV.B       @R6+,R5
        ADDC        R3,R2
        ; @bug logic: a later pixel of a row rounds a half down where the sum
        ; the pixel before it halved was even. this SETT at 0x8c18a8ec is
        ; meant to set c to 1 for ADDC R4,R3 at 0x8c18a8f6. SHAR R2 at
        ; 0x8c18a8ee replaces T first, with the low bit of the sum it halves
        SETT
        SHAR        R2
        EXTU.B      R5,R5
        MOV.B       R2,@R0
        MOV.B       @R6+,R2
        ADDC        R4,R3
        SETT
        SHAR        R3
        EXTU.B      R2,R2
        MOV.B       R3,@(R0,R7)
        MOV.B       @R6+,R3
        ADDC        R5,R4
        SETT
        SHAR        R4
        EXTU.B      R3,R3
        MOV.B       R4,@(R0,R8)
        MOV.B       @R6+,R4
        ADDC        R2,R5
        SETT
        SHAR        R5
        EXTU.B      R4,R4
        MOV.B       R5,@(R0,R9)
        MOV.B       @R6+,R5
        ADDC        R3,R2
        SETT
        SHAR        R2
        EXTU.B      R5,R5
        MOV.B       R2,@(R0,R10)
        MOV.B       @R6,R2
        ADDC        R4,R3
        SETT
        SHAR        R3
        EXTU.B      R2,R2
        MOV.B       R3,@(R0,R11)
        ADDC        R5,R4
        SETT
        SHAR        R4
        ADDC        R2,R5
        MOV.B       R4,@(R0,R12)
        SHAR        R5
        MOV.B       R5,@(R0,R13)
        DT          R1
        BF/S        ?h2_row
        ADD         R14,R6
        MOV.L       @R15+,R8
        MOV.L       @R15+,R9
        MOV.L       @R15+,R10
        MOV.L       @R15+,R11
        MOV.L       @R15+,R12
        MOV.L       @R15+,R13
        RTS
        MOV.L       @R15+,R14
        .ALIGN      4

; void MPVAMC_OneRef4(struct mpv_mc *mc)
; set each pixel of mc->block to (a + b + c + d + 2) >> 2. a and b are the
; pixel at its place in mc->src and the one to its right. c and d are the
; same two in mc->src2. the rows of mc->src and mc->src2 lie mc->pitch bytes
; apart. the call also reads mc->src[8 * mc->pitch] and
; mc->src2[8 * mc->pitch], which must be readable
; @asm open: every instruction is one SHC writes for C
_MPVAMC_OneRef4:
        MOV.L       R14,@-R15
        MOV         #BLK_LINES,R1
        MOV.L       @(MC_PITCH,R4),R14
        MOV.L       R13,@-R15
        MOV.L       R12,@-R15
        MOV.L       R11,@-R15
        ADD         #-ROW_BYTES,R14
        MOV.L       @(MC_SRC,R4),R6
        MOV.L       @(MC_SRC2,R4),R7
        MOV.L       @(MC_BLOCK,R4),R13
        MOV.B       @R6+,R2
        MOV.B       @R7+,R3
?four_row:
        EXTU.B      R2,R2
        MOV.B       @R6+,R4
        EXTU.B      R3,R3
        MOV.B       @R7+,R5
        ADD         R3,R2
        MOV.B       @R6+,R11
        EXTU.B      R4,R4
        MOV.B       @R7+,R12
        EXTU.B      R5,R5
        ADD         R5,R4
        EXTU.B      R11,R11
        EXTU.B      R12,R12
        ADD         R12,R11
        MOV.B       @R7+,R3
        MOV         R2,R0
        ADD         R4,R0
        MOV.B       @R6+,R2
        ADD         #2,R0
        SHLR2       R0
        EXTU.B      R2,R2
        MOV.B       R0,@R13
        EXTU.B      R3,R3
        ADD         R3,R2
        MOV.B       @R7+,R5
        MOV         R4,R0
        ADD         R11,R0
        MOV.B       @R6+,R4
        ADD         #2,R0
        SHLR2       R0
        EXTU.B      R4,R4
        MOV.B       R0,@(1,R13)
        EXTU.B      R5,R5
        ADD         R5,R4
        MOV.B       @R7+,R12
        MOV         R11,R0
        ADD         R2,R0
        MOV.B       @R6+,R11
        ADD         #2,R0
        SHLR2       R0
        EXTU.B      R11,R11
        MOV.B       R0,@(2,R13)
        EXTU.B      R12,R12
        ADD         R12,R11
        MOV.B       @R7+,R3
        MOV         R2,R0
        ADD         R4,R0
        MOV.B       @R6+,R2
        ADD         #2,R0
        SHLR2       R0
        EXTU.B      R2,R2
        MOV.B       R0,@(3,R13)
        EXTU.B      R3,R3
        ADD         R3,R2
        MOV.B       @R7+,R5
        MOV         R4,R0
        ADD         R11,R0
        MOV.B       @R6+,R4
        ADD         #2,R0
        SHLR2       R0
        EXTU.B      R4,R4
        MOV.B       R0,@(4,R13)
        EXTU.B      R5,R5
        ADD         R5,R4
        MOV.B       @R7,R12
        MOV         R11,R0
        ADD         R2,R0
        MOV.B       @R6,R11
        ADD         #2,R0
        SHLR2       R0
        EXTU.B      R11,R11
        MOV.B       R0,@(5,R13)
        EXTU.B      R12,R12
        ADD         R12,R11
        MOV         R2,R0
        ADD         R4,R0
        ADD         #2,R0
        SHLR2       R0
        MOV.B       R0,@(6,R13)
        MOV         R4,R0
        ADD         R11,R0
        ADD         #2,R0
        SHLR2       R0
        MOV.B       R0,@(7,R13)
        ADD         R14,R6
        MOV.B       @R6+,R2
        ADD         R14,R7
        MOV.B       @R7+,R3
        DT          R1
        BF/S        ?four_row
        ADD         #ROW_BYTES,R13
        MOV.L       @R15+,R11
        MOV.L       @R15+,R12
        MOV.L       @R15+,R13
        RTS
        MOV.L       @R15+,R14
        .END
