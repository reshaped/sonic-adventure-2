        MOV         R5,R8
        MOV.W       #LONG_STEP-RING_BYTES,R9
        MOV         #SAMPLES,R7
        ADD         #CACHE_LINE,R8
        MOV         R4,R1
        MOV         R7,R3
        ADD         #FLOAT_BYTES,R1
        MOV.W       #LONG_STEP,R0
        ADD         #SHORT_STEP-SAMPLES,R3
        FLDI0       FR15
        FMOV.S      @R4,FR0
        ADD         R0,R4
        FMOV.S      @R4,FR1
        ADD         R3,R4
        FMOV.S      @R4,FR2
        ADD         R0,R4
        FMOV.S      @R4,FR3
        ADD         R3,R4
        FSCHG
        PREF        @R8
        FMOV        @R5+,DR4
        FMOV        @R5+,DR6
        FMOV        @R5+,DR8
        FIPR        FV0,FV4
        FMOV        @R5+,DR10
        FSCHG
        FMOV.S      @R4,FR0
        ADD         R0,R4
        FMOV.S      @R4,FR1
        ADD         R3,R4
        FMOV.S      @R4,FR2
        ADD         R0,R4
        FADD        FR7,FR15
        FMOV.S      @R4,FR3
        BRA         ?taps8
        ADD         R3,R4
?sample:
        FADD        FR11,FR15
        FMOV.S      @R4,FR0
        ADD         R0,R4
        FMOV.S      @R4,FR1
        ADD         R3,R4
        FMOV.S      @R4,FR2
        ADD         R0,R4
        FMOV.S      @R4,FR3
        ADD         R3,R4
        FSCHG
        FMOV        @R5+,DR4
        FTRC        FR15,FPUL
        FMOV        @R5+,DR6
        ADD         #CACHE_LINE,R8
        STS         FPUL,R2
        FMOV        @R5+,DR8
        SHLR16      R2
        FIPR        FV0,FV4
        FMOV        @R5+,DR10
        FSCHG
        MOV.W       R2,@R6
        ADD         #SAMPLE_BYTES,R6
        FMOV.S      @R4,FR0
        ADD         R0,R4
        FMOV.S      @R4,FR1
        ADD         R3,R4
        FLDI0       FR15
        FMOV.S      @R4,FR2
        ADD         R0,R4
        FADD        FR7,FR15
        FMOV.S      @R4,FR3
        ADD         R3,R4
?taps8:
        PREF        @R8
        FMOV.S      @R4,FR4
        FIPR        FV0,FV8
        ADD         R0,R4
        FMOV.S      @R4,FR5
        ADD         R3,R4
        FMOV.S      @R4,FR6
        ADD         R0,R4
        FMOV.S      @R4,FR7
        ADD         R3,R4
        FADD        FR11,FR15
        FSCHG
        FMOV        @R5+,DR0
        ADD         #CACHE_LINE,R8
        FMOV        @R5+,DR2
        FMOV        @R5+,DR8
        FIPR        FV0,FV4
        FMOV        @R5+,DR10
        FSCHG
        FMOV.S      @R4,FR0
        ADD         R0,R4
        FMOV.S      @R4,FR1
        ADD         R3,R4
        FMOV.S      @R4,FR2
        FADD        FR7,FR15
        ADD         R9,R4
        FMOV.S      @R4,FR3
        PREF        @R8
        DT          R7
        MOV         R1,R4
        FIPR        FV0,FV8
        BF/S        ?sample
        ADD         #FLOAT_BYTES,R1
        FADD        FR11,FR15
        FTRC        FR15,FPUL
        STS         FPUL,R2
        SHLR16      R2
        FMOV.S      @R15+,FR15
        FMOV.S      @R15+,FR14
        FMOV.S      @R15+,FR13
        FMOV.S      @R15+,FR12
        MOV.L       @R15+,R9
        MOV.L       @R15+,R8
        RTS
        MOV.W       R2,@R6

