        FMOV.S      @R4,FR4
        FIPR        FV0,FV8
        ADD         R0,R4
        FMOV.S      @R4,FR5
        ADD         R3,R4
        FMOV.S      @R4,FR6
        ADD         R0,R4
        FMOV.S      @R4,FR7
        ADD         R3,R4
        FADD        FR11,FR15
        FSCHG
        FMOV        @R5+,DR0
        ADD         #CACHE_LINE,R8
