; the player's copy of its stream into its decoder (mwsfd.h)
        .IMPORT     _memcpy
        .IMPORT     _syCacheOCBI
        .EXPORT     _mwPlySh4CpyMem
        .SECTION    PSG,CODE,ALIGN=4

; void mwPlySh4CpyMem(void *dest, const void *src, Sint32 bytes)
; @asm opcode: cache-line, OCBI @R9 at 0x8c545374 drops the destination's
; line
_mwPlySh4CpyMem:
        MOV.L       R14,@-R15
        MOV         R6,R14
        CMP/PL      R14
        BF          ?empty
        MOV         #31,R6                  ; the offset bits of a line
        MOV         R4,R2
        TST         R6,R2
        BF          ?unaligned
        MOV         R5,R1
        TST         R6,R1
        BF          ?unaligned
        MOV         R14,R6
        BRA         ?aligned
        MOV.L       @R15+,R14
?unaligned:
        MOV.L       memcpy_address,R2
        MOV         R14,R6
        JMP         @R2
        MOV.L       @R15+,R14
?empty:
        RTS
        MOV.L       @R15+,R14

; the queues' copy. R9 is the destination's line and R10 the source's, and
; R8 holds SR as it was. each line goes through the store queue at
; H'E0000000 plus the destination's low 26 bits, with every interrupt
; masked. the frame holds the queue's address, the lines left and the QACR
; value, a long word each from R15 up
?aligned:
        MOV.L       R12,@-R15
        FSCHG                               ; SZ 1: an FMOV moves a pair
        MOV.L       R11,@-R15
        MOV         #-5,R3                  ; the shift that divides by a line
        MOV.L       R10,@-R15
        MOV.L       R9,@-R15
        MOV         R5,R10
        MOV.L       R8,@-R15
        MOV         R4,R9
        STS.L       PR,@-R15
        ADD         #-12,R15
        STC         SR,R8
        SHAD        R3,R6
        MOV.L       R6,@(4,R15)
        MOV         R9,R0
        NOP
        SHLR16      R0
        MOV.L       queue_offset_mask,R3
        SHLR8       R0
        MOV.L       queue_base,R2
        AND         R9,R3
        AND         #H'1C,R0                ; dest's bits 28 to 26
        OR          R2,R3
        MOV.L       R0,@(8,R15)
        MOV.L       R3,@R15
        PREF        @R10
        MOV.L       @(4,R15),R3
        CMP/PL      R3
        BF          ?finish
?next_line:
        MOV         R10,R2
        ADD         #32,R2
        PREF        @R2
        STC         SR,R0
        MOV.W       interrupt_mask_clear,R3
        AND         R3,R0
        OR          #H'F0,R0                ; SR.IMASK 15 masks every interrupt
        LDC         R0,SR
        MOV.L       @R15,R3
        FMOV        @R10+,DR0
        FMOV        @R10+,DR2
        FMOV        @R10+,DR4
        FMOV        @R10+,DR6
        FMOV        DR0,@R3
        ADD         #8,R3
        FMOV        DR2,@R3
        ADD         #8,R3
        FMOV        DR4,@R3
        ADD         #8,R3
        FMOV        DR6,@R3
        ADD         #8,R3
        OCBI        @R9
        MOV         R9,R4
        MOV.L       @(8,R15),R2
        MOV.L       queue_control_0,R3
        MOV.L       R2,@R3
        MOV.L       @(8,R15),R1
        MOV.L       queue_control_1,R2
        MOV.L       R1,@R2
        MOV.L       @R15,R1
        PREF        @R1                     ; writes the queue out
        LDC         R8,SR
        MOV.L       @R15,R0
        ADD         #32,R9
        ADD         #32,R0
        MOV.L       R0,@R15
        MOV.L       @(4,R15),R3
        ADD         #-1,R3
        CMP/PL      R3
        BT/S        ?next_line
        MOV.L       R3,@(4,R15)
?finish:
        ADD         #12,R15
        LDS.L       @R15+,PR
        MOV.L       @R15+,R8
        MOV.L       @R15+,R9
        MOV.L       @R15+,R10
        FSCHG
        MOV.L       @R15+,R11
        RTS
        MOV.L       @R15+,R12
        .ALIGN      4
interrupt_mask_clear:
        .DATA.W     H'FF0F
        .DATA.W     0
memcpy_address:
        .DATA.L     _memcpy
        .DATA.L     _syCacheOCBI
queue_offset_mask:
        .DATA.L     H'03FFFFFF
queue_base:
        .DATA.L     H'E0000000
queue_control_0:
        .DATA.L     H'FF000038
queue_control_1:
        .DATA.L     H'FF00003C
        .END
