        NOP

; Sint32 gdBtGdcReInitEntry(void)
; @asm operand: integer-constant, MOV.L #0,R7 at 0x8c137366 loads the small
; constant 0 from the pool
_gdBtGdcReInitEntry:
        MOV         #-1,R6
        MOV.L       #0,R7
        MOV.L       #GDC_VECTOR,R0
        MOV.L       @R0,R0
        JMP         @R0
        NOP

; Sint32 gdBtGdcAddDesc(Sint32 descriptor, Uint32 address)
; @asm operand: integer-constant, MOV.L #1,R7 at 0x8c13737a loads the small
; constant 1 from the pool
_gdBtGdcAddDesc:
        MOV         #-1,R6
        MOV.L       #1,R7
        MOV.L       #GDC_VECTOR,R0
        MOV.L       @R0,R0
        JMP         @R0
        NOP

        .END
