        .SECTION    DSGLH,DATA,ALIGN=4

; void START_SYS(void)
; the program's entry. it invalidates the instruction cache by CCR.ICI,
; clears the bits CCR doesn't define, and jumps to _INIT. its code fills
; the 32 bytes that open the module, ahead of the records. its pool doubles
; as the start record's first 16 bytes, which come before the record's ID
_START_SYS:
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        MOV.L       ccr_address,R0
        MOV.L       @R0,R1
        MOV.L       ccr_defined_bits,R2
        AND         R2,R1
        MOV.W       ccr_ici,R2
        OR          R2,R1
        MOV.L       R1,@R0
        MOV.L       init_address,R0
        JMP         @R0
        NOP
ccr_ici:
        .DATA.W     H'0800
        .ALIGN      4
ccr_address:
        .DATA.L     H'FF00001C
ccr_defined_bits:
        .DATA.L     H'000089AF
init_address:
        .DATA.L     __INIT
; strt1_records.c supplies the start ID after this pool and the end record
; in DSGLE. ov_main.c supplies the one library handle between them.
        .SECTION    DSGLE,DATA,ALIGN=4

        .SECTION    P,CODE,ALIGN=4
        .SECTION    C,DATA,ALIGN=4

; _INITSCT copies the program's initial data from D to R and R32, and
; zeroes B and B32. R and R32 are empty in the linked program, so the data
; runs in place in D, and the copy moves nothing. _D4_END and _B4_END end R
; and B, the sections aligned to 4 bytes, and _D_END and _B_END end R32 and
; B32, aligned to 32

; Uint8 *_D_ROM
__D_ROM:
        .DATA.L     (STARTOF D)
; Uint8 *_D32_ROM
__D32_ROM:
        .DATA.L     (STARTOF D32)
; Uint8 *_D_BGN
__D_BGN:
        .DATA.L     (STARTOF R)
; Uint8 *_D4_END
__D4_END:
        .DATA.L     (STARTOF R)+(SIZEOF R)
; Uint8 *_D32_BGN
__D32_BGN:
        .DATA.L     (STARTOF R32)
; Uint8 *_D_END
__D_END:
        .DATA.L     (STARTOF R32)+(SIZEOF R32)
; Uint32 *_B_BGN
__B_BGN:
        .DATA.L     (STARTOF B)
; Uint32 *_B4_END
__B4_END:
        .DATA.L     (STARTOF B)+(SIZEOF B)
; Uint32 *_B32_BGN
__B32_BGN:
        .DATA.L     (STARTOF B32)
; Uint32 *_B_END
__B_END:
        .DATA.L     (STARTOF B32)+(SIZEOF B32)

; the four tables of functions that syStartGlobalConstructor and
; syStartGlobalDestructor call. DSG_INIT_ and DSG_END_ are the SDK's, and
; D_INIT_ and D_END_ the program's. all four are empty in the linked
; program

; table_func *_PRESG_BGN
__PRESG_BGN:
        .DATA.L     (STARTOF DSG_INIT_)
; table_func *_PRESG_END
__PRESG_END:
        .DATA.L     (STARTOF DSG_INIT_)+(SIZEOF DSG_INIT_)
; table_func *_POSTSG_BGN
__POSTSG_BGN:
        .DATA.L     (STARTOF DSG_END_)
; table_func *_POSTSG_END
__POSTSG_END:
        .DATA.L     (STARTOF DSG_END_)+(SIZEOF DSG_END_)
; table_func *_PRE_BGN
__PRE_BGN:
        .DATA.L     (STARTOF D_INIT_)
; table_func *_PRE_END
__PRE_END:
        .DATA.L     (STARTOF D_INIT_)+(SIZEOF D_INIT_)
; table_func *_POST_BGN
__POST_BGN:
        .DATA.L     (STARTOF D_END_)
; table_func *_POST_END
__POST_END:
        .DATA.L     (STARTOF D_END_)+(SIZEOF D_END_)

        .SECTION    C32,DATA,ALIGN=32
        .SECTION    D,DATA,ALIGN=4
        .SECTION    D32,DATA,ALIGN=32
        .SECTION    DSG_INIT_,DATA,ALIGN=4
        .SECTION    DSG_END_,DATA,ALIGN=4
        .SECTION    CSG_$VTBL,DATA,ALIGN=4
        .SECTION    D_INIT_,DATA,ALIGN=4
        .SECTION    D_END_,DATA,ALIGN=4
        .SECTION    C_$VTBL,DATA,ALIGN=4
        .SECTION    R,DATA,ALIGN=4
        .SECTION    R32,DATA,ALIGN=32
        .SECTION    PSG,CODE,ALIGN=4
        .SECTION    CSG,DATA,ALIGN=4

; OVMDL _DSGLH_BGN
; the program's module, whose libraries _INITLIBH enters
__DSGLH_BGN:
        .DATA.L     (STARTOF DSGLH)
; Uint8 *_DSGLH_END
__DSGLH_END:
        .DATA.L     (STARTOF DSGLH)+(SIZEOF DSGLH)
; Uint8 *_DSGLE_BGN
__DSGLE_BGN:
        .DATA.L     (STARTOF DSGLE)
; Uint8 *_DSGLE_END
__DSGLE_END:
        .DATA.L     (STARTOF DSGLE)+(SIZEOF DSGLE)

; _INITSCT copies the libraries' initial data from DSG to RSG and RSG32,
; and zeroes BSG and BSG32. RSG and RSG32 are empty in the linked program,
; as R and R32 are. _DSG4_END and _BSG4_END end RSG and BSG, aligned to 4
; bytes, and _DSG_END and _BSG_END end RSG32 and BSG32, aligned to 32

; Uint8 *_DSG_ROM
__DSG_ROM:
        .DATA.L     (STARTOF DSG)
; Uint8 *_DSG32_ROM
__DSG32_ROM:
        .DATA.L     (STARTOF DSG32)
; Uint8 *_DSG_BGN
__DSG_BGN:
        .DATA.L     (STARTOF RSG)
; Uint8 *_DSG4_END
__DSG4_END:
        .DATA.L     (STARTOF RSG)+(SIZEOF RSG)
; Uint8 *_DSG32_BGN
__DSG32_BGN:
        .DATA.L     (STARTOF RSG32)
; Uint8 *_DSG_END
__DSG_END:
        .DATA.L     (STARTOF RSG32)+(SIZEOF RSG32)
; Uint8 *_BSG_BGN
__BSG_BGN:
        .DATA.L     (STARTOF BSG)
; Uint8 *_BSG4_END
__BSG4_END:
        .DATA.L     (STARTOF BSG)+(SIZEOF BSG)
; Uint8 *_BSG32_BGN
__BSG32_BGN:
        .DATA.L     (STARTOF BSG32)
; Uint8 *_BSG_END
; sbinit.c puts the heap in the area of the address space this end lies in
__BSG_END:
        .DATA.L     (STARTOF BSG32)+(SIZEOF BSG32)
; Uint8 *_G0_BGN
; $G0 holds the data addressed through GBR, and is empty in the linked
; program
__G0_BGN:
        .DATA.L     (STARTOF $G0)

