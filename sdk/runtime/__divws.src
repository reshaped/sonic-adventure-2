        .IMPORT     __errno
        .EXPORT     __divws

; errno.h's code for a division by zero
EDIV:           .EQU    1102

        .SECTION    P,CODE,ALIGN=4

; signed 16-bit division for compiled code: R0 = (short)R1 / (short)R0. it
; changes R0, R1 and SR's Q, M and T bits, and no other register. a zero
; divisor sets errno to EDIV and returns 0
; @asm opcode: rotcl, ROTCL R0 at 0x8c0cd052 shifts the last quotient bit in
; from T
__divws:
        EXTS.W      R0,R0
        TST         R0,R0
        BT/S        ?divide_by_zero
        MOV.L       R2,@-R15
        EXTS.W      R1,R1
        MOV         #0,R2
        DIV0S       R2,R1
        SUBC        R2,R1
        SHLL16      R0
        DIV0S       R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        DIV1        R0,R1
        EXTS.W      R1,R0
        ROTCL       R0
        ADDC        R2,R0
        RTS
        MOV.L       @R15+,R2
?divide_by_zero:
        MOV.L       ?errno_address,R2
        MOV.L       ?errno_value,R1
        MOV.L       R1,@R2
        RTS
        MOV.L       @R15+,R2
?errno_address:
        .DATA.L     __errno
?errno_value:
        .DATA.L     EDIV
        .END
