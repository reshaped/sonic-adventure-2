; __q_mvn.obj is member 29 (zero-based) of Katana R11b sh4nlfzn.lib.
; Its linked text matches the retail image. Its SYSROF record names
; A_SH as the tool that wrote the object.

        .EXPORT     __quick_mvn

; the most bytes mvn_copy_table copies. a longer copy takes the loop
TABLE_BYTES:    .EQU    64

        .SECTION    P,CODE,ALIGN=4

; copy R0 bytes from R2 to R1. R0 must be a multiple of 4. both blocks must
; be 4-byte aligned, and must not overlap. it changes R0 and T, and R1 too for
; a copy of more than TABLE_BYTES. no other register changes. such a copy also
; reads the long word after the source, which must be readable
; @asm open: no inspect rule reads R0 to R2 at its entry
__quick_mvn:
        MOV.L       R3,@-R15
        MOV         #TABLE_BYTES,R3
        CMP/HS      R0,R3
        BF          mvn_copy_loop_entry
        MOV.L       mvn_copy_table_address,R3
        MOV.L       @(R0,R3),R3
        JMP         @R3
        NOP
mvn_copy_table_address:
        .DATA.L     mvn_copy_table
; nothing reaches this NOP: no branch and no entry of mvn_copy_table leads
; here
        NOP
mvn_words_16:
        MOV.L       @(60,R2),R0
        MOV.L       R0,@(60,R1)
mvn_words_15:
        MOV.L       @(56,R2),R0
        MOV.L       R0,@(56,R1)
mvn_words_14:
        MOV.L       @(52,R2),R0
        MOV.L       R0,@(52,R1)
mvn_words_13:
        MOV.L       @(48,R2),R0
        MOV.L       R0,@(48,R1)
mvn_words_12:
        MOV.L       @(44,R2),R0
        MOV.L       R0,@(44,R1)
mvn_words_11:
        MOV.L       @(40,R2),R0
        MOV.L       R0,@(40,R1)
mvn_words_10:
        MOV.L       @(36,R2),R0
        MOV.L       R0,@(36,R1)
mvn_words_9:
        MOV.L       @(32,R2),R0
        MOV.L       R0,@(32,R1)
mvn_words_8:
        MOV.L       @(28,R2),R0
        MOV.L       R0,@(28,R1)
mvn_words_7:
        MOV.L       @(24,R2),R0
        MOV.L       R0,@(24,R1)
mvn_words_6:
        MOV.L       @(20,R2),R0
        MOV.L       R0,@(20,R1)
mvn_words_5:
        MOV.L       @(16,R2),R0
        MOV.L       R0,@(16,R1)
mvn_words_4:
        MOV.L       @(12,R2),R0
        MOV.L       R0,@(12,R1)
mvn_words_3:
        MOV.L       @(8,R2),R0
        MOV.L       R0,@(8,R1)
mvn_words_2:
        MOV.L       @(4,R2),R0
        MOV.L       R0,@(4,R1)
mvn_words_1:
        MOV.L       @R2,R0
        MOV.L       R0,@R1
mvn_done:
        RTS
        MOV.L       @R15+,R3
        .ALIGN      4
; the entry R0 bytes into this table copies R0 / 4 long words, the last first
mvn_copy_table:
        .DATA.L     mvn_done
        .DATA.L     mvn_words_1
        .DATA.L     mvn_words_2
        .DATA.L     mvn_words_3
        .DATA.L     mvn_words_4
        .DATA.L     mvn_words_5
        .DATA.L     mvn_words_6
        .DATA.L     mvn_words_7
        .DATA.L     mvn_words_8
        .DATA.L     mvn_words_9
        .DATA.L     mvn_words_10
        .DATA.L     mvn_words_11
        .DATA.L     mvn_words_12
        .DATA.L     mvn_words_13
        .DATA.L     mvn_words_14
        .DATA.L     mvn_words_15
        .DATA.L     mvn_words_16
mvn_copy_loop_entry:
        MOV.L       R2,@-R15
        MOV         R2,R3
        ADD         R0,R3
mvn_copy_loop:
        MOV.L       @R2+,R0
        CMP/HS      R2,R3
        BF          mvn_copy_done
        MOV.L       R0,@R1
        MOV.L       @R2+,R0
        CMP/HS      R2,R3
        BF          mvn_copy_done
        MOV.L       R0,@(4,R1)
        BRA         mvn_copy_loop
        ADD         #8,R1
mvn_copy_done:
        MOV.L       @R15+,R2
        RTS
        MOV.L       @R15+,R3
        .END
