        .IMPORT     __errno
        .EXPORT     __modlu

; errno.h's code for a division by zero
EDIV:           .EQU    1102

        .SECTION    P,CODE,ALIGN=4

; unsigned remainder for compiled code: R0 = R1 % R0. it changes R0, R1 and
; SR's Q, M and T bits, and no other register. a zero divisor sets errno to
; EDIV and returns 0
; @asm opcode: rotcl, ROTCL R1 at 0x8c0c0fee and the 31 after it shift the
; dividend out of R1 through T
__modlu:
        TST         R0,R0
        BT          ?divide_by_zero
        MOV.L       R3,@-R15
        MOV         #0,R3
        MOV.L       R4,@-R15
        MOV         R0,R4
        DIV0U
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        ROTCL       R1
        DIV1        R4,R3
        BF          ?add_divisor
        MOV         R3,R0
        MOV.L       @R15+,R4
        RTS
        MOV.L       @R15+,R3
?add_divisor:
        ADD         R3,R0
        MOV.L       @R15+,R4
        RTS
        MOV.L       @R15+,R3
?divide_by_zero:
        MOV.L       R2,@-R15
        MOV.L       ?errno_address,R1
        MOV.L       ?errno_value,R2
        MOV         #0,R0
        MOV.L       R2,@R1
        RTS
        MOV.L       @R15+,R2
        .ALIGN      4
?errno_address:
        .DATA.L     __errno
?errno_value:
        .DATA.L     EDIV
        .END
