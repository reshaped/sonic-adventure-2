; __s_scpy.obj is member 34 (zero-based) of Katana R11b sh4nlfzn.lib.
; Its linked text matches the retail image. Its SYSROF record names
; A_SH as the tool that wrote the object.

        .IMPORT     _quick_strcpy1
        .EXPORT     __slow_strcpy

        .SECTION    P,CODE,ALIGN=4

; copy the string at R1 to R0, terminator included, and return R0. the two
; must not overlap. neither needs to be aligned. where both are 4-byte
; aligned, quick_strcpy1 makes the copy. it changes R1 and T, and keeps every
; other register
; @asm open: no inspect rule reads R0 or R1 at its entry
__slow_strcpy:
        MOV.L       R3,@-R15
        MOV.L       R4,@-R15
        MOV         #3,R3
        MOV         R0,R4
        AND         R3,R4
        AND         R1,R3
        OR          R4,R3
        TST         R3,R3
        BT          ?both_aligned
        MOV         R0,R4
        MOV.B       @R1+,R0
        MOV         R4,R3
?copy_four:
        CMP/EQ      #0,R0
        MOV.B       R0,@R3
        BT          ?copy_done
        MOV.B       @R1+,R0
        CMP/EQ      #0,R0
        MOV.B       R0,@(1,R3)
        BT          ?copy_done
        MOV.B       @R1+,R0
        CMP/EQ      #0,R0
        MOV.B       R0,@(2,R3)
        BT          ?copy_done
        MOV.B       @R1+,R0
        CMP/EQ      #0,R0
        MOV.B       R0,@(3,R3)
        BT          ?copy_done
        MOV.B       @R1+,R0
        BRA         ?copy_four
        ADD         #4,R3
?copy_done:
        MOV         R4,R0
        MOV.L       @R15+,R4
        RTS
        MOV.L       @R15+,R3
; quick_strcpy1 pops the R3 and R4 pushed above
?both_aligned:
        MOV.L       ?quick_entry,R3
        JMP         @R3
        NOP
        .ALIGN      4
?quick_entry:
        .DATA.L     _quick_strcpy1
        .END
